<div class="container mx-auto px-4 py-8" data-controller="page-refresh view-toggle time-period">
  <div id="page-header" class="flex justify-between items-center mb-2">
    <%= image_tag "livebeat-logo.png", alt: "LiveBeat", class: "h-16" %>
    <div class="flex items-center space-x-4">
      <!-- View Toggle -->
      <div class="flex bg-gray-200 rounded-lg p-1">
        <button data-view-toggle-target="listViewBtn" data-action="click->view-toggle#showListView" class="px-3 py-1 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900">
          List View
        </button>
        <button data-view-toggle-target="mapViewBtn" data-action="click->view-toggle#showMapView" class="px-3 py-1 rounded-md bg-white shadow-sm text-sm font-medium text-gray-900">
          Map View
        </button>
      </div>
      <!-- Time Period Selector -->
      <div class="flex bg-gray-200 rounded-lg p-1" data-time-period-target="container">
        <button
          data-time-period-target="button"
          data-period="24h"
          data-action="click->time-period#selectPeriod"
          class="px-3 py-1 rounded-md text-sm font-medium transition-all <%= 'bg-white shadow-sm text-gray-900' if @time_period == '24h' %> <%= 'text-gray-600 hover:text-gray-900' if @time_period != '24h' %>">
          24h
        </button>
        <button
          data-time-period-target="button"
          data-period="48h"
          data-action="click->time-period#selectPeriod"
          class="px-3 py-1 rounded-md text-sm font-medium transition-all <%= 'bg-white shadow-sm text-gray-900' if @time_period == '48h' %> <%= 'text-gray-600 hover:text-gray-900' if @time_period != '48h' %>">
          48h
        </button>
        <button
          data-time-period-target="button"
          data-period="week"
          data-action="click->time-period#selectPeriod"
          class="px-3 py-1 rounded-md text-sm font-medium transition-all <%= 'bg-white shadow-sm text-gray-900' if @time_period == 'week' %> <%= 'text-gray-600 hover:text-gray-900' if @time_period != 'week' %>">
          Week
        </button>
        <button
          data-time-period-target="button"
          data-period="month"
          data-action="click->time-period#selectPeriod"
          class="px-3 py-1 rounded-md text-sm font-medium transition-all <%= 'bg-white shadow-sm text-gray-900' if @time_period == 'month' %> <%= 'text-gray-600 hover:text-gray-900' if @time_period != 'month' %>">
          Month
        </button>
        <button
          data-time-period-target="button"
          data-period="all"
          data-action="click->time-period#selectPeriod"
          class="px-3 py-1 rounded-md text-sm font-medium transition-all <%= 'bg-white shadow-sm text-gray-900' if @time_period == 'all' %> <%= 'text-gray-600 hover:text-gray-900' if @time_period != 'all' %>">
          All
        </button>
      </div>
      <% if current_user&.venue? %>
        <%= link_to 'New Event', new_scheduled_event_path, class: "px-3 py-1 rounded-md text-sm font-medium bg-gradient-to-r from-purple-600 to-blue-500 text-white hover:from-purple-700 hover:to-blue-600 transition-all duration-300" %>
      <% end %>
    </div>
  </div>

  <!-- Map View -->
  <div id="map-view" data-view-toggle-target="mapView">
    <div class="w-full" style="height: calc(100vh - 64px - 64px);">
      <% if @mapbox_token.present? %>
        <div
          data-controller="map"
          data-map-token-value="<%= @mapbox_token %>"
          data-map-events-value="<%= @events_for_map.to_json %>"
          class="w-full h-full"
        ></div>
      <% else %>
        <div class="flex items-center justify-center h-full bg-gray-100 text-gray-500">
          <div class="text-center">
            <p class="text-lg font-semibold mb-2">Mapbox API Key Not Configured</p>
            <p class="text-sm">Please set the MAPBOX_API_KEY environment variable to display the map.</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- List View -->
  <div id="list-view" data-view-toggle-target="listView" class="hidden">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @scheduled_events.each do |event| %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <% if event.photos.attached? %>
            <div class="h-48 overflow-hidden">
              <%= cl_image_tag event.photos.first.key,
                  height: 300,
                  width: 400,
                  crop: :fill,
                  class: "w-full h-full object-cover" %>
            </div>
          <% end %>
          <div class="p-6">
            <h2 class="text-xl font-semibold mb-2"><%= event.title %></h2>
            <p class="text-gray-600 mb-2"><%= event.location %></p>
            <p class="text-gray-600 mb-2">Category: <%= event.category %></p>
            <p class="text-gray-600 mb-2">
              <%= event.starting_time.strftime("%B %d, %Y at %I:%M %p") %>
            </p>
            <p class="text-gray-600 mb-4">Price: $<%= event.price %></p>

            <div class="flex justify-between items-center">
              <%= link_to 'View', event, class: "text-blue-500 hover:text-blue-700" %>
              <% if current_user&.venue? && event.venue == current_user.venue %>
                <%= link_to 'Edit', edit_scheduled_event_path(event), class: "text-green-500 hover:text-green-700" %>
                <%= button_to 'Delete', event, method: :delete, class: "text-red-500 hover:text-red-700", form: { data: { turbo_confirm: 'Are you sure?' } } %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
