<%= form_with(model: scheduled_event, class: "space-y-6") do |form| %>
  <% if scheduled_event.errors.any? %>
    <div class="bg-red-500/20 backdrop-blur-sm p-4 rounded-xl border border-red-300/30">
      <h2 class="text-white font-medium mb-2">
        <%= pluralize(scheduled_event.errors.count, "error") %> prohibited this event from being saved:
      </h2>
      <ul class="list-disc list-inside text-white/90">
        <% scheduled_event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% input_classes = "w-full px-4 py-3 rounded-xl border-0 bg-white/20 text-purple-700 placeholder-white/60 focus:bg-white/30 focus:ring-2 focus:ring-white/50 transition-all" %>
  <% label_classes = "block text-sm font-medium text-white/90 mb-2" %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="form-group">
      <%= form.label :title, class: label_classes %>
      <%= form.text_field :title, class: input_classes %>
    </div>

    <div class="form-group" data-controller="location-autocomplete"
         data-location-autocomplete-user-latitude-value="<%= current_user&.latitude %>"
         data-location-autocomplete-user-longitude-value="<%= current_user&.longitude %>">
      <%= form.label :location, class: label_classes %>
      <div class="relative">
        <%= form.text_field :location,
            data: {
              location_autocomplete_target: "input",
              action: "input->location-autocomplete#onInput keydown->location-autocomplete#onKeydown"
            },
            class: input_classes %>
      </div>
      <div data-location-autocomplete-target="suggestions" class="hidden mt-2 relative"></div>

      <!-- Hidden fields for coordinates -->
      <%= form.hidden_field :latitude, data: { location_autocomplete_target: "latitude" } %>
      <%= form.hidden_field :longitude, data: { location_autocomplete_target: "longitude" } %>

      <p class="mt-1 text-sm text-white/70">
        💡 Tip: Start typing to see location suggestions.
      </p>
    </div>

    <div class="form-group">
      <%= form.label :category, class: label_classes %>
      <%= form.select :category,
          event_categories,
          { prompt: "Select a category" },
          { class: input_classes } %>
    </div>

    <div class="form-group">
      <%= form.label :venue_id, class: label_classes %>
      <%= form.collection_select :venue_id, Venue.all, :id, :name, {}, { class: input_classes } %>
    </div>

    <div class="form-group">
      <%= form.label :starting_time, class: label_classes %>
      <%= form.datetime_field :starting_time, class: input_classes %>
    </div>

    <div class="form-group">
      <%= form.label :ending_time, class: label_classes %>
      <%= form.datetime_field :ending_time, class: input_classes %>
    </div>

    <div class="form-group">
      <%= form.label :price, class: label_classes %>
      <%= form.number_field :price, step: :any, class: input_classes %>
    </div>

    <div class="form-group">
      <%= form.label :capacity, class: label_classes %>
      <%= form.number_field :capacity, class: input_classes %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :description, class: label_classes %>
    <%= form.text_area :description, rows: 4, class: input_classes %>
  </div>

  <div class="form-group" data-controller="file-upload">
    <%= form.label :photos, "Event Photos", class: label_classes %>

    <% if scheduled_event.persisted? && scheduled_event.photos.attached? %>
      <div class="flex flex-wrap gap-4 mb-2">
        <% scheduled_event.photos.each do |photo| %>
          <% if photo.respond_to?(:id) && photo.persisted? %>
            <div class="relative group">
              <%= image_tag url_for(photo), class: "h-24 w-24 object-cover rounded-xl shadow-lg" %>
              <label class="absolute top-1 right-1 bg-white/80 backdrop-blur-sm rounded-lg p-1 cursor-pointer group-hover:bg-red-100 text-xs text-gray-700">
                <%= check_box_tag "remove_photo_ids[]", photo.id, false %> Remove
              </label>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= form.file_field :photos,
          multiple: true,
          accept: "image/*",
          data: {
            file_upload_target: "input",
            action: "change->file-upload#updatePreview"
          },
          class: "block w-full text-sm text-white/90 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-white/20 file:text-white hover:file:bg-white/30 file:backdrop-blur-sm" %>
    </div>
    <div data-file-upload-target="preview" class="mt-2"></div>
    <div data-file-upload-target="error" class="mt-2 text-sm text-white/90"></div>
    <p class="mt-2 text-sm text-white/70">
      Upload between 2 and 6 photos. Supported formats: JPEG, PNG, JPG, GIF. Maximum file size: 5MB each.
    </p>
  </div>

  <div class="flex justify-end space-x-4 pt-4 border-t border-white/20">
    <%= link_to 'Cancel', scheduled_events_path, class: "px-6 py-3 bg-white/20 backdrop-blur-sm text-white rounded-xl hover:bg-white/30 transition font-semibold" %>
    <%= form.submit class: "px-6 py-3 bg-white text-purple-700 rounded-xl hover:bg-purple-100 transition font-semibold" %>
  </div>
<% end %>
